{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-ssh",
  "version": "1.0.0-beta.1",
  "description": "Exécution de commandes sur une machine distante par SSH (russh). Clé d'hôte épinglée, secrets gardés hors de la conversation.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-ssh",
  "repository": "https://github.com/Locaryn/morph-ssh",
  "keywords": [
    "ssh",
    "remote-execution",
    "ai-connector",
    "devops",
    "server-management"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le client MCP de gestion des sessions SSH distantes."
    },
    "network": {
      "reason": "Établir des connexions TCP/SSH sortantes vers les serveurs cibles."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "ssh-remote-exec"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "ssh-studio",
        "slot": "studio.tabs",
        "order": 30,
        "label": "Sessions SSH",
        "icon": "server",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-ssh-panel",
        "hint": "Exécution d'ordres et gestion de serveurs distants"
      },
      {
        "id": "ssh-workspaces",
        "slot": "chat.workspaces",
        "order": 10,
        "label": "Emplacements SSH",
        "icon": "server",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-ssh-workspaces",
        "hint": "Emplacements de travail et serveurs distants SSH"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
